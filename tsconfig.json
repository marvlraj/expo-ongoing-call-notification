{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020", "dom"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./build",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "index.ts",
    "OngoingCallNotificationModule.ts",
    "OngoingCallNotificationModule.web.ts",
    "plugin/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "plugin/build"
  ]
}
